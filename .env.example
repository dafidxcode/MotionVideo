REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# --- LLM Provider (dibaca DARI ENV) ---
# Pilihan: anthropic (default) | openai
LLM_PROVIDER=anthropic

# Anthropic (LLM utama: generate animasi, validasi, skill detection)
ANTHROPIC_API_KEY=
# Opsional — override model default:
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# OpenAI (opsional fallback LLM; TTS voiceover sudah diganti HeyGen sepenuhnya)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# OPENAI_FAST_MODEL=gpt-6-luna
# NOTE: pilihan model di UI selalu menang atas LLM_PROVIDER —
# model "claude-*" -> Anthropic, "gpt-*"/"o*" -> OpenAI.
# LLM_PROVIDER hanya default bila client tidak mengirim model.
# Semua model katalog bersifat multimodal: text / image / video (frames).

# --- HeyGen TTS Voiceover ---
# Sumber tunggal untuk sintesis suara (menggantikan OpenAI TTS).
# Dipakai oleh /api/voices (katalog suara per bahasa) dan /api/voiceover.
# Ambil dari https://app.heygen.com/developers/api
HEYGEN_API_KEY=
# Bahasa yang didukung di UI: en (English) | ms (Malay) | id (Indonesian)
# Speech engine (dropdown "Voice Model"): auto | starfish | orca | elevenlabs
# OPENAI_API_KEY tetap opsional: hanya dipakai sebagai fallback word-level
# timestamps bila HeyGen tidak mengembalikan word_timestamps.
