# --- Session & Auth (WAJIB — fail-closed) ---
# Generate: openssl rand -base64 48   (minimal 32 karakter)
# TIDAK ada fallback hardcoded. Jika kosong/terlalu pendek, semua sesi ditolak
# dan middleware /api akan menolak semua request (status 503/401).
AUTH_SESSION_SECRET=
# Opsional — secret lama saat rotasi. Hanya untuk verifikasi, maks 1 nilai.
# AUTH_SESSION_SECRET_PREVIOUS=

# --- Google Sign-In (WAJIB) ---
# ID token dari Google HANYA diterima bila aud = nilai ini (BUG-05).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Cloudflare Turnstile (WAJIB di production) ---
# Jika kosong, login DITOLAK (fail-closed, BUG-04).
# Escape hatch khusus lokal: TURNSTILE_ALLOW_UNCONFIGURED=true
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITEKEY=

# --- Swdbot / Supabase profile store ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SERVICE_ROLE_KEY=

# --- Admin emails (pisahkan dengan koma) ---
# ADMIN_EMAILS=you@example.com

REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# --- LLM Provider (dibaca DARI ENV) ---
# Pilihan: anthropic (default) | openai
LLM_PROVIDER=anthropic

# Anthropic Claude API (LLM utama: Opus untuk visual generation, Haiku untuk deteksi skill & validasi)
ANTHROPIC_API_KEY=
# Opsional — override model default:
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI (opsional untuk audio transcription Whisper di /api/transcribe)
OPENAI_API_KEY=

# --- HeyGen TTS Voiceover ---
# Sumber tunggal untuk sintesis suara (menggantikan OpenAI TTS).
# Dipakai oleh /api/voices (katalog suara per bahasa) dan /api/voiceover.
# Ambil dari https://app.heygen.com/developers/api
HEYGEN_API_KEY=
# Bahasa yang didukung di UI: en (English) | ms (Malay) | id (Indonesian)
# Speech engine (dropdown "Voice Model"): auto | starfish | orca | elevenlabs
# OPENAI_API_KEY tetap opsional: hanya dipakai sebagai fallback word-level
# timestamps bila HeyGen tidak mengembalikan word_timestamps.
